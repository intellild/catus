{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
  },
  "include": [
    "e2e/**/*.ts",
    "fixtures/**/*.ts",
    "setup.ts",
    "rstest.config.ts",
  ],
}
