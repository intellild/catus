# Midscene model configuration.
# Copy this file to `.env` and fill in your own values.
# Docs: https://midscenejs.com/zh/computer-getting-started.html
#       https://midscenejs.com/zh/model-strategy.html

# OpenAI-compatible base URL of your model service (must end with /v1 for most
# providers).
MIDSCENE_MODEL_BASE_URL="https://your-model-service/v1"

# API key for the model service.
MIDSCENE_MODEL_API_KEY="your-api-key"

# Model name as exposed by the provider (e.g. "qwen3-vl-plus", "gemini-3.5-flash").
MIDSCENE_MODEL_NAME="your-model-name"

# Model family. Midscene uses this to pick the right visual-grounding strategy.
# Recommended families: qwen3, glm, doubao, gemini. See the model strategy docs.
MIDSCENE_MODEL_FAMILY="your-model-family"
